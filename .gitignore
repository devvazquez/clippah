# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ruff_cache/
.pytest_cache/

# Artwork de emojis de Apple: se baja con `make setup-emoji`, no se versiona (27 MB y
# es propiedad de Apple).
backend/assets/emoji/
# Montserrat la baja `make setup-font`: 450 KB de binario no van al repo.
backend/assets/fonts/

# Backend data (media, thumbs, sqlite). Se excluye el contenido y no la carpeta, porque
# git no vuelve a incluir nada dentro de un directorio excluido.
backend/data/*
!backend/data/.gitkeep
# Las transcripciones completas SI se versionan: 60 KB de texto por directo, y son lo que
# permite buscar un momento ("donde dicen X") sin volver a gastar cuota de transcripcion.
!backend/data/transcripts/
backend/data/transcripts/*
!backend/data/transcripts/*.tsv
# Los trozos a medias, no: son el andamio de una transcripcion que se quedo a mitad.
backend/data/transcripts/*.parts/
# Red de seguridad: ningun data/ suelto en el repo
/data/

# Env
.env
.env.local

# Node / Next
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Cache de wrangler al desplegar en Pages.
.wrangler/
