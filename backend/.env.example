# --- Proveedores (todos opcionales; sin ninguno la app funciona en modo local) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Pipeline ---
DOWNLOAD_MODE=stream_seek     # stream_seek | full
MAX_VOD_HOURS=8
BIN_SECONDS=2
CHAT_LAG_S=8
W_CHAT=1.0
W_USERS=1.2
W_EMOTE=1.5
W_AUDIO=0.8
PEAK_PERCENTILE=97
MIN_GAP_S=45
MAX_CANDIDATES=30
TOP_N=12
MIN_CLIP_S=12
MAX_CLIP_S=60

# --- Local ---
WHISPER_MODEL=large-v3-turbo  # large-v3-turbo | medium | small
WHISPER_DEVICE=auto           # auto | cpu | cuda
DATA_DIR=./data

# --- Extras ---
KEEP_MEDIA=0                  # 1 = no borrar el WAV al terminar el job
EDGE_TRIM_S=60                # segundos descartados al inicio y al final del VOD
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Cuotas de proveedores (bajalas para probar la degradacion) ---
GROQ_RPM=20
GROQ_RPD=2000
GROQ_ASH=7200
GROQ_ASD=28800
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_RPM=15
GEMINI_RPD=1000
GEMINI_TPM=250000

# --- yt-dlp (opcional) ---
# YouTube pide verificacion anti-bot desde IPs de datacenter. Pasar cookies lo resuelve:
YTDLP_COOKIES_FROM_BROWSER=   # firefox | chrome | brave | edge | chrome:Profile 1
YTDLP_COOKIES_FILE=           # o una ruta a cookies.txt (formato Netscape)
YTDLP_EXTRA_ARGS=             # argumentos extra para yt-dlp, tal cual

# --- Proponente visual (necesita GEMINI_API_KEY) ---
# Las senales de audio y chat solo encuentran momentos con reaccion. Esto muestrea
# fotogramas y le pregunta a Gemini cuales muestran algo (un hito visual silencioso).
VISION_ENABLED=1
VISION_SAMPLE_S=20           # un fotograma cada N segundos
VISION_FRAME_WIDTH=512
VISION_BATCH=15              # fotogramas por peticion
VISION_MIN_CONFIDENCE=60
VISION_MAX_HITS=12           # candidatos visuales aceptados como maximo
VISION_MODEL=                # vacio = usa GEMINI_MODEL

# --- Render del clip (vertical 9:16 con subtitulos quemados) ---
TARGET_CLIP_S=26              # mediana real de los clips mas vistos de auronplay e ibai
RENDER_LAYOUT=blur            # blur (no pierde nada) | crop (recorta 9:16) | split
RENDER_ZOOM=1.0               # >1 agranda la imagen recortando los laterales
RENDER_FONT_SIZE=82
RENDER_WORDS_PER_LINE=3       # 2-3 palabras se leen de un vistazo en vertical
RENDER_CHARS_PER_LINE=22
RENDER_UPPERCASE=1
RENDER_CRF=20
RENDER_PRESET=veryfast
RENDER_FPS=30
